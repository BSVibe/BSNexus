# Infrastructure
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql+asyncpg://bsnexus:bsnexus_dev@postgres:5432/bsnexus

# DB connection pool (S2-1 M19/H13). Defaults keep prior behavior:
# 30 concurrent sessions (10 + 20 overflow). Bump for production
# deployments running many delegated agents in parallel.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_S=60
# -1 = no recycle. Set to 1800 (30 min) when behind PgBouncer / RDS proxy.
DB_POOL_RECYCLE_S=-1

# BSVibe Auth
BSVIBE_AUTH_URL=https://auth.bsvibe.dev
FRONTEND_URL=http://localhost:3000

# OAuth2 client_credentials grant — see BSVibe-Auth /api/oauth/token.
# Provision a row in `oauth_clients` for BSNexus (`bsnexus-prod`); the
# plaintext secret is shown once and kept in Vaultwarden. Empty in dev →
# get_service_jwt_minter() returns None and adapters drop to Noop.
BSVIBE_CLIENT_ID=
BSVIBE_CLIENT_SECRET=

# Security
PROMPT_SIGNING_KEY=change-me-generate-with-secrets-token-hex-32
ENCRYPTION_KEY=change-me-generate-with-secrets-token-hex-32
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://bsserver:3000"]
RATE_LIMIT_ENABLED=true
ENABLE_HSTS=false

# Server
DEBUG=false

# Deployment environment — set to "production" to disable the
# E2E_TEST_TOKEN bypass guardrail. Use "development", "staging", or
# leave blank for non-prod environments.
ENVIRONMENT=development

# E2E test bypass token — short-circuits BSVibe Auth and returns a
# synthetic admin user. Honored only when ENVIRONMENT != "production".
# Leave blank in any environment that doesn't run e2e tests.
E2E_TEST_TOKEN=

# Logging
LOG_LEVEL=INFO

# Frontend (Vite)
VITE_API_URL=
VITE_BSVIBE_AUTH_URL=https://auth.bsvibe.dev
VITE_ALLOWED_HOSTS=

# NOTE: LLM API keys and models are configured per-tenant via the
# Settings UI in the app (stored in DB). No env-var fallback.

# ── Audit (Phase Audit Batch 2) ─────────────────────────────────────
# bsvibe-audit OutboxRelay configuration. Empty BSVIBE_AUTH_AUDIT_URL
# disables the relay entirely (dev-friendly default) — emitted events
# accumulate in audit_outbox until the URL/token are wired.
BSVIBE_AUTH_AUDIT_URL=
BSVIBE_AUTH_AUDIT_SERVICE_TOKEN=
AUDIT_OUTBOX_TABLE_NAME=audit_outbox
AUDIT_BATCH_SIZE=50
AUDIT_RELAY_INTERVAL_S=5.0
AUDIT_MAX_RETRIES=5
# Optional explicit on/off override (defaults to on iff URL is set).
# AUDIT_RELAY_ENABLED=
AUDIT_SERVICE_NAME=bsnexus
