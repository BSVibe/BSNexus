# Infrastructure
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql+asyncpg://bsnexus:bsnexus_dev@postgres:5432/bsnexus

# BSVibe Auth
BSVIBE_AUTH_URL=https://auth.bsvibe.dev
FRONTEND_URL=http://localhost:3000

# Security
PROMPT_SIGNING_KEY=change-me-generate-with-secrets-token-hex-32
ENCRYPTION_KEY=change-me-generate-with-secrets-token-hex-32
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://bsserver:3000"]
RATE_LIMIT_ENABLED=true
ENABLE_HSTS=false

# Server
DEBUG=false

# LLM — configure via Settings UI in the app (DB-stored).
# These env vars are fallbacks only. Leave empty to force DB config.
DEFAULT_LLM_MODEL=
DEFAULT_LLM_BASE_URL=

# Claude Code executor (worker path)
EXECUTOR_SKIP_PERMISSIONS=true

# Logging
LOG_LEVEL=INFO

# Frontend (Vite)
VITE_API_URL=
VITE_BSVIBE_AUTH_URL=https://auth.bsvibe.dev
VITE_ALLOWED_HOSTS=
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=3000

# E2E Testing
API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_BASE_URL=http://localhost:3000

# NOTE: LLM API keys are configured per session/project at runtime,
# not as environment variables.
