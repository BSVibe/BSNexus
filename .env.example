# Infrastructure
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql+asyncpg://bsnexus:bsnexus_dev@postgres:5432/bsnexus

# Supabase Auth
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# BSVibe Auth
BSVIBE_AUTH_URL=https://auth.bsvibe.dev
FRONTEND_URL=http://localhost:3000

# Security
PROMPT_SIGNING_KEY=change-me-generate-with-secrets-token-hex-32
ENCRYPTION_KEY=change-me-generate-with-secrets-token-hex-32
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_ENABLED=true
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# LLM Defaults (fallback when not specified at runtime)
DEFAULT_LLM_MODEL=
DEFAULT_LLM_BASE_URL=

# Executor
EXECUTOR_TYPE=claude_code
EXECUTION_TIMEOUT_SECONDS=3600
TOTAL_EXECUTION_TIMEOUT_SECONDS=7200
RATE_LIMIT_RETRY_COUNT=5
RATE_LIMIT_WAIT_SECONDS=300
EXECUTOR_SKIP_PERMISSIONS=true

# Auto-redesign
MAX_AUTO_REDESIGNS=2

# Provider Selection (bsgateway|litellm, bsupervisor|noop, bsage|local)
GATEWAY_PROVIDER=litellm
SUPERVISOR_PROVIDER=noop
KNOWLEDGE_PROVIDER=local

# Provider URLs (only needed when using bs* providers)
BSGATEWAY_URL=
BSGATEWAY_API_KEY=
BSUPERVISOR_URL=
BSUPERVISOR_API_KEY=
BSAGE_URL=
BSAGE_API_KEY=

# Local knowledge directory (used when KNOWLEDGE_PROVIDER=local)
KNOWLEDGE_DIR=./knowledge

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO

# Frontend (Vite)
VITE_API_URL=
VITE_BSVIBE_AUTH_URL=https://auth.bsvibe.dev
VITE_ALLOWED_HOSTS=
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=3000

# E2E Testing
API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_BASE_URL=http://localhost:3000

# NOTE: LLM API keys are configured per session/project at runtime,
# not as environment variables. Pass llm_config when creating Architect sessions.
