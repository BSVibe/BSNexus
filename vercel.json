{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npx --yes pnpm@10 install --frozen-lockfile",
  "buildCommand": "cd frontend && npx --yes pnpm@10 run build && cp -r .next ../.next-out",
  "outputDirectory": ".next-out",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-nexus.bsvibe.dev/api/:path*"
    }
  ]
}
