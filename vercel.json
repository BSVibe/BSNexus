{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npx --yes pnpm@10 install --frozen-lockfile",
  "buildCommand": "cd frontend && npx --yes pnpm@10 run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-nexus.bsvibe.dev/api/:path*"
    }
  ]
}
