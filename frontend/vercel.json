{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-nexus.bsvibe.dev/api/:path*"
    }
  ]
}
