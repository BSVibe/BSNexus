# BSNexus frontend — public env vars are visible in the client bundle.
# Next.js inlines anything prefixed with NEXT_PUBLIC_* at build time.

# Backend API base. Leave blank to use same-origin ``/api`` paths via the
# Next.js dev rewrite (next.config.mjs). Set to e.g. http://localhost:18100
# for direct cross-origin access in dev/devcontainer.
NEXT_PUBLIC_API_URL=

# BSVibe auth service. Defaults to https://auth.bsvibe.dev when unset.
NEXT_PUBLIC_AUTH_URL=

# Server-side only: dev-server proxy target for the isolated e2e
# orchestrator (see ``next.config.mjs``). Not exposed to the client.
# E2E_PROXY_TARGET=
