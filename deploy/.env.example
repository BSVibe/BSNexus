# =============================================================================
# BSNexus Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git!
# =============================================================================

# ── Infrastructure: PostgreSQL ─────────────────────────────────
POSTGRES_DB=bsnexus
POSTGRES_USER=bsnexus
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=your_secure_password_here

# ── Authentication ────────────────────────────────────────────
BSVIBE_AUTH_URL=https://auth.bsvibe.dev
FRONTEND_URL=http://localhost:3100

# ── Security ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PROMPT_SIGNING_KEY=change-me
ENCRYPTION_KEY=change-me
CORS_ALLOWED_ORIGINS=["http://localhost:3100"]

# ── Executor ───────────────────────────────────────────────────
EXECUTOR_TYPE=claude_code
EXECUTION_TIMEOUT_SECONDS=3600

# ── LLM (fallback, runtime override preferred) ─────────────────
DEFAULT_LLM_MODEL=
DEFAULT_LLM_BASE_URL=

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
