# =============================================================================
# BSNexus Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git!
# =============================================================================

# ── Infrastructure: PostgreSQL ─────────────────────────────────
POSTGRES_DB=bsnexus
POSTGRES_USER=bsnexus
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=your_secure_password_here

# ── Authentication ────────────────────────────────────────────
BSVIBE_AUTH_URL=https://auth.bsvibe.dev
FRONTEND_URL=http://localhost:3100

# ── Token introspection (RFC 7662) ─────────────────────────────
# REQUIRED in prod — without these three, the backend can only verify
# user JWTs (not opaque ``bsv_sk_*`` PATs and not the HS256 PAT JWTs
# the device-flow grant emits). Phase 8 dogfood (2026-05-11) caught
# four products silently 401'ing because these were never set.
#
# 1. Provision a row in BSVibe-Auth's ``oauth_clients`` for this
#    backend (e.g. ``bsnexus-prod`` confidential client). The raw
#    secret is shown once at creation; store it in Vaultwarden.
# 2. Set the three vars below from that row.
#
# Both ``UNPREFIXED`` and ``BSV_PREFIXED`` names work (Wave 3 added
# AliasChoices in backend/src/config.py).
INTROSPECTION_URL=https://auth.bsvibe.dev/oauth/introspect
INTROSPECTION_CLIENT_ID=bsnexus-prod
INTROSPECTION_CLIENT_SECRET=<64-hex-from-oauth_clients-issue>

# ── Security ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PROMPT_SIGNING_KEY=change-me
ENCRYPTION_KEY=change-me
CORS_ALLOWED_ORIGINS=["http://localhost:3100"]

# ── Executor ───────────────────────────────────────────────────
EXECUTOR_TYPE=claude_code
EXECUTION_TIMEOUT_SECONDS=3600

# ── LLM (fallback, runtime override preferred) ─────────────────
DEFAULT_LLM_MODEL=
DEFAULT_LLM_BASE_URL=

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
