# BSNexus DEMO environment template (deploy/.env.demo).
#
# Copy to `deploy/.env.demo` and fill in real values. `.env.demo` is gitignored.
# This file configures the PUBLIC INTERACTIVE DEMO stack — separate from prod.
#
# Generate secrets:
#   openssl rand -hex 32      # for DEMO_JWT_SECRET, ENCRYPTION_KEY, PROMPT_SIGNING_KEY
#   openssl rand -base64 32   # for POSTGRES_PASSWORD

# ─── Demo session signing (per-product, NOT shared with prod auth.bsvibe.dev) ───
DEMO_JWT_SECRET=

# ─── Database (isolated demo PG) ───
POSTGRES_USER=bsnexus_demo
POSTGRES_PASSWORD=
POSTGRES_DB=bsnexus_demo

# DB pool (smaller than prod — demo is read-heavy)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30
DB_POOL_RECYCLE_S=-1

# ─── Frontend / CORS (demo domain only) ───
FRONTEND_URL=https://demo-nexus.bsvibe.dev
CORS_ALLOWED_ORIGINS=["https://demo-nexus.bsvibe.dev"]

# ─── Demo executor (mock — no real Claude Code / Codex spawning) ───
EXECUTOR_TYPE=mock
EXECUTION_TIMEOUT_SECONDS=60

# ─── LLM (mock — demo composition uses scripted responses) ───
DEFAULT_LLM_MODEL=mock

# ─── Cross-product demo URLs (for trust card displays — all mocked at runtime) ───
BSGATEWAY_URL=https://api-demo-gateway.bsvibe.dev
BSAGE_URL=https://api-demo-sage.bsvibe.dev
BSUPERVISOR_URL=https://api-demo-supervisor.bsvibe.dev

# ─── Security (rotate per environment) ───
ENCRYPTION_KEY=
PROMPT_SIGNING_KEY=

# ─── BSVibe Auth (demo backend ignores prod auth — kept for code that imports settings) ───
BSVIBE_AUTH_URL=https://auth.bsvibe.dev
BSVIBE_CLIENT_ID=
BSVIBE_CLIENT_SECRET=

# ─── Logging ───
LOG_LEVEL=INFO
